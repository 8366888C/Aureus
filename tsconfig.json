{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "NodeNext" /* Required for native ESM in Node.js */,
    "moduleResolution": "NodeNext" /* Ensures imports work correctly with "type": "module" */,

    /* Type Checking */
    "strict": true /* This covers all the "strict..." flags you listed */,
    "skipLibCheck": true /* Keeps build times fast */,

    /* Emit - Handled largely by tsup, but good for IDE support */
    "outDir": "./dist",
    "declaration": true /* Generates .d.ts files for your package users */,

    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true /* Required for transpilers like esbuild/tsup */,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
