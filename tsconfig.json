{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* Type Checking */
    "strict": true,
    "skipLibCheck": true,

    /* Emit - Handled largely by tsup, but good for IDE support */
    "outDir": "./dist",
    "declaration": true,

    /* Interop Constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true /* required for transpilers like esbuild/tsup */,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
